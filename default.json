{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    "schedule:daily",
    ":timezone(Europe/Berlin)",
    ":semanticCommits",
    ":enableVulnerabilityAlerts",
    "helpers:pinGitHubActionDigestsToSemver",
    "customManagers:githubActionsVersions"
  ],
  "osvVulnerabilityAlerts": true,
  "reviewersFromCodeOwners": true,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Wait 3 days before proposing a new release so malicious or broken releases can be caught and yanked",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Skip the release-age window for update types without a release timestamp, which would otherwise never be raised",
      "matchUpdateTypes": [
        "replacement",
        "lockFileMaintenance",
        "pin",
        "bump",
        "lockfileUpdate",
        "rollback"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip the release-age window for own GitHub Actions and container images",
      "matchPackageNames": [
        "ThorstenSauter/**",
        "ghcr.io/thorstensauter/**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip the release-age window for trusted Microsoft, Azure and Aspire NuGet packages",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Aspire.**",
        "Azure.**",
        "Microsoft.**"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Skip the release-age window for trusted Azure, Next.js and React npm packages",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@azure/**",
        "next",
        "@next/**",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Group Docker image updates",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "Docker",
      "groupSlug": "docker",
      "addLabels": [
        "docker"
      ]
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "addLabels": [
        "github_actions"
      ]
    },
    {
      "description": "Group non-major npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Non-major NPM dependencies",
      "groupSlug": "non-major-npm-dependencies",
      "addLabels": [
        "npm"
      ]
    },
    {
      "description": "Label major npm updates, which get their own PRs",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "npm"
      ]
    },
    {
      "description": "Group non-major NuGet updates",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Non-major NuGet dependencies",
      "groupSlug": "non-major-nuget-dependencies",
      "addLabels": [
        ".NET"
      ]
    },
    {
      "description": "Label major NuGet updates, which get their own PRs",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        ".NET"
      ]
    },
    {
      "description": "Group Terraform provider and TFLint plugin updates",
      "matchManagers": [
        "terraform",
        "tflint-plugin"
      ],
      "groupName": "Terraform providers and TFLint plugins",
      "groupSlug": "terraform-providers-and-tflint-plugins",
      "addLabels": [
        "terraform"
      ]
    },
    {
      "description": "Flag every major update as potentially breaking",
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "breaking"
      ]
    }
  ]
}
